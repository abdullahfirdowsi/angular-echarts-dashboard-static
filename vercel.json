{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/angular-echarts-dashboard/browser",
        "buildCommand": "npm run build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(assets|images|favicon.ico|.*\\.png|.*\\.svg|.*\\.jpg|.*\\.jpeg|.*\\.gif|.*\\.json|.*\\.woff|.*\\.woff2|.*\\.ttf|.*\\.eot)$",
      "dest": "/$1"
    },
    {
      "src": "/(.*\\.js|.*\\.css)$",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "github": {
    "silent": true
  }
}

